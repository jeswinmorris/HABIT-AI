{
  "name": "habit-os-desktop",
  "version": "5.3.5",
  "description": "HABIT.AI v5.3 — system-clock driven, OS-delivered reminders, single day plan, no placeholder data",
  "author": "JESWIN <jeswin@errorfreakz.com>",
  "main": "electron/main.cjs",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron.\"",
    "build": "vite build",
    "setup": "node download-model.js && node download-piper.js",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:win": "vite build && electron-builder --win --x64 --publish=never",
    "build:mac": "vite build && electron-builder --mac --x64 --arm64 --publish=never",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "better-sqlite3": "^11.3.0",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vosk-browser": "^0.0.8",
    "onnxruntime-web": "^1.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^22.20.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.5.6",
    "concurrently": "^8.2.0",
    "electron": "28.3.3",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.habitai.app",
    "productName": "HABIT.AI",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/onnxruntime-web/**/*"
    ],
    "files": [
      "dist/renderer/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": ".",
        "filter": ["**/*", "!**/*.zip"]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "minimumSystemVersion": "11.0.0",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}