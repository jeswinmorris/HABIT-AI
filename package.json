{
  "name": "habit-os-desktop",
  "version": "5.1.0",
  "description": "HABIT.AI v5.1 — Personal OS (voice-fix + pause day + STEAK reminders), exact v4.1 design",
  "author": "JESWIN <jeswin@errorfreakz.com>",
  "main": "electron/main.cjs",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "setup": "node download-piper.js && node download-model.js",
    "model": "node download-model.js",
    "piper": "node download-piper.js",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:electron": "npm run build && electron-builder --win --mac --linux --publish=never",
    "build:win": "npm run build && electron-builder --win nsis msi --publish=never",
    "build:win:exe": "npm run build && electron-builder --win nsis --publish=never",
    "build:win:msi": "npm run build && electron-builder --win msi --publish=never",
    "build:mac": "npm run build && electron-builder --mac --publish=never",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "better-sqlite3": "^11.3.0",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^22.20.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.5.6",
    "concurrently": "^8.2.0",
    "electron": "28.3.3",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
  "appId": "com.habitai.app",
  "productName": "HABIT.AI",
  "asar": true,
  "asarUnpack": [
    "**/node_modules/better-sqlite3/**/*"
  ],
  "files": [
    "dist/renderer/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "public",
      "to": ".",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64"]
      }
    ],
    "minimumSystemVersion": "10.13.0",
    "category": "public.app-category.productivity"
  },
  "win": {
    "target": ["nsis"]
  },
  "directories": {
    "output": "dist/installers",
    "buildResources": "public"
  }
}
}